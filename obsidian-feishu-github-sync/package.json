{
  "name": "obsidian-feishu-github-sync",
  "version": "2.0.0",
  "description": "Bidirectional sync between Obsidian, Feishu docs, and GitHub",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.ts --bundle --external:obsidian --outfile=main.js --format=cjs --platform=browser",
    "dev": "npm run build -- --watch"
  },
  "keywords": ["obsidian", "feishu", "github", "sync"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "isomorphic-git": "^1.25.0",
    "obsidian": "^1.4.0"
  }
}
